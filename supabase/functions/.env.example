# Secrets des Edge Functions (copier en supabase/functions/.env pour `supabase functions serve --env-file`,
# ou les enregistrer sur le projet : `supabase secrets set --env-file supabase/functions/.env`).
# SUPABASE_URL, SUPABASE_ANON_KEY et SUPABASE_SERVICE_ROLE_KEY sont injectés automatiquement
# par Supabase : ne pas les définir.

# Clé API Anthropic (obligatoire pour la fonction `ai` ; sans elle, réponses de secours uniquement).
ANTHROPIC_API_KEY=

# Modèle utilisé (défaut : claude-haiku-5-5).
ANTHROPIC_MODEL=claude-haiku-5-5

# Quota par utilisateur sur 24 h glissantes (les réponses servies par le cache ne comptent pas).
AI_DAILY_QUOTA=40

# Plafond mensuel global d'appels au fournisseur (mois civil UTC). Au-delà : réponses de secours (503).
AI_MONTHLY_BUDGET_REQUESTS=200000

# Délai par tentative vers le fournisseur, en millisecondes (défaut 20000).
# ANTHROPIC_TIMEOUT_MS=20000
