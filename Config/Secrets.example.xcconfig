// Copie ce fichier en Config/Secrets.xcconfig (ignoré par git) et renseigne tes valeurs.
// En CI, ce fichier est généré à partir des secrets GitHub (voir .github/workflows/testflight.yml).

// Préfixe des identifiants : l'app devient <préfixe>.quinze, l'App Group group.<préfixe>.quinze.
BUNDLE_ID_PREFIX = fr.elmdigitalagency

// Identifiant d'équipe Apple Developer (10 caractères, visible dans developer.apple.com > Compte > Adhésion).
DEVELOPMENT_TEAM = ABCDE12345

// « // » commence un commentaire dans un xcconfig : on écrit https:/$()/ à la place de https://
SUPABASE_URL = https:/$()/YOUR-PROJECT-REF.supabase.co

// Clé « anon » publique de Supabase (jamais la clé service_role).
SUPABASE_ANON_KEY = your-anon-key
